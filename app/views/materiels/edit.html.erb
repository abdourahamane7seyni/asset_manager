<% content_for :page_title, "Modifier Matériel" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-1">Modifier <%= @materiel.nom %></h4>
    <p class="text-muted mb-0">Mettre à jour les informations du matériel</p>
  </div>
  <%= link_to materiels_path, class: "btn btn-outline-secondary" do %>
    <i class="bi bi-arrow-left"></i> Retour
  <% end %>
</div>

<%= render "form", materiel: @materiel %>
