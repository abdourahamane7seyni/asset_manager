<div style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center;">
  <div style="background: white; border-radius: 20px; padding: 40px; width: 100%; max-width: 420px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
    <div style="width:70px; height:70px; background: linear-gradient(135deg, #0d6efd, #0f3460); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 2rem; color: white; margin: 0 auto 20px;">
      <i class="bi bi-pc-display-horizontal"></i>
    </div>
    <h4 class="text-center fw-bold mb-1">Asset Manager</h4>
    <p class="text-center text-muted mb-4">Connectez-vous à votre compte</p>

    <% if alert %>
      <div class="alert alert-danger rounded-3"><i class="bi bi-exclamation-circle me-2"></i><%= alert %></div>
    <% end %>

    <form action="/users/sign_in" method="post" data-turbo="false">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <div class="mb-3">
        <label class="form-label fw-semibold">Email</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
          <input type="email" name="user[email]" class="form-control border-start-0 ps-0" placeholder="votre@email.com" autofocus style="border-radius: 0 10px 10px 0;">
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold">Mot de passe</label>
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
          <input type="password" name="user[password]" class="form-control border-start-0 ps-0" placeholder="••••••••" style="border-radius: 0 10px 10px 0;">
        </div>
      </div>
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
          <input type="checkbox" name="user[remember_me]" class="form-check-input" value="1">
          <label class="form-check-label text-muted small">Se souvenir de moi</label>
        </div>
        <%= link_to "Mot de passe oublié ?", new_user_password_path, class: "text-primary text-decoration-none small" %>
      </div>
      <button type="submit" class="btn btn-primary w-100 fw-semibold py-2" style="border-radius: 10px; background: linear-gradient(135deg, #0d6efd, #0f3460); border: none;">
        Se connecter
      </button>
    </form>

    <hr class="my-4">
    <p class="text-center text-muted mb-0 small">
      Pas encore de compte ?
      <%= link_to "S'inscrire", new_user_registration_path, class: "text-primary fw-semibold text-decoration-none" %>
    </p>
  </div>
</div>
