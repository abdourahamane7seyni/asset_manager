<% content_for :page_title, "Employés" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-1">Gestion des Employés</h4>
    <p class="text-muted mb-0">Liste de tous les employés</p>
  </div>
  <%= link_to employees_path(format: :pdf), class: "btn btn-outline-danger me-2" do %>
    <i class="bi bi-file-pdf"></i> PDF
  <% end %>
  <%= link_to employees_path(format: :xlsx), class: "btn btn-outline-success me-2" do %>
    <i class="bi bi-file-excel"></i> Excel
  <% end %>
  <%= link_to "/employees/new", class: "btn btn-primary" do %>
    <i class="bi bi-plus-lg"></i> Nouvel Employé
  <% end %>
</div>

<!-- Recherche -->
<div class="card mb-4 p-3">
  <div class="row g-2">
    <div class="col-md-4">
      <input type="text" id="searchInput" class="form-control" placeholder="🔍 Rechercher un employé...">
    </div>
    <div class="col-md-3">
      <select id="deptFilter" class="form-select">
        <option value="">Tous les départements</option>
        <option>Informatique</option>
        <option>Finance</option>
        <option>RH</option>
        <option>Direction</option>
        <option>Commercial</option>
      </select>
    </div>
  </div>
</div>

<!-- Cartes employés -->
<div class="row g-4" id="employeesGrid">
  <% @employees.each do |employee| %>
    <div class="col-md-4 employee-card">
      <div class="card p-4">
        <div class="d-flex align-items-center mb-3">
          <div class="stat-icon me-3" style="background:#e8f4fd; color:#0d6efd; width:50px; height:50px; font-size:1.3rem; border-radius:50%;">
            <i class="bi bi-person"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-0"><%= employee.first_name %> <%= employee.last_name %></h6>
            <small class="text-muted"><%= employee.department %></small>
          </div>
        </div>
        <div class="mb-2">
          <i class="bi bi-envelope text-muted me-2"></i>
          <small><%= employee.email %></small>
        </div>
        <div class="mb-3">
          <i class="bi bi-telephone text-muted me-2"></i>
          <small><%= employee.phone.present? ? employee.phone : "—" %></small>
        </div>
        <div class="d-flex gap-2">
          <%= link_to employee, class: "btn btn-sm btn-outline-primary" do %>
            <i class="bi bi-eye"></i> Voir
          <% end %>
          <%= link_to edit_employee_path(employee), class: "btn btn-sm btn-outline-secondary" do %>
            <i class="bi bi-pencil"></i> Modifier
          <% end %>
          <%= link_to employee, method: :delete, data: { confirm: "Supprimer cet employé ?" }, class: "btn btn-sm btn-outline-danger" do %>
            <i class="bi bi-trash"></i>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  <% if @employees.empty? %>
    <div class="col-12 text-center text-muted py-5">
      <i class="bi bi-people" style="font-size:2rem;"></i>
      <p class="mt-2">Aucun employé enregistré</p>
    </div>
  <% end %>
</div>

<script>
  document.getElementById('searchInput').addEventListener('input', filterEmployees);
  document.getElementById('deptFilter').addEventListener('change', filterEmployees);

  function filterEmployees() {
    const search = document.getElementById('searchInput').value.toLowerCase();
    const dept = document.getElementById('deptFilter').value.toLowerCase();
    document.querySelectorAll('.employee-card').forEach(card => {
      const text = card.textContent.toLowerCase();
      card.style.display = (text.includes(search) && text.includes(dept)) ? '' : 'none';
    });
  }
</script>
